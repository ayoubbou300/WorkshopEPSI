# Fins de ligne Unix forcées : ces fichiers sont exécutés ou lus dans des conteneurs Linux.
# Sans cela, Git pour Windows (core.autocrlf=true) les convertit en CRLF et Mosquitto,
# nginx ou les scripts shell échouent au démarrage.
*.sh                text eol=lf
*.conf              text eol=lf
*.template          text eol=lf
infra/mosquitto/acl text eol=lf
infra/mosquitto/acl-legacy text eol=lf
*.sql               text eol=lf
*.py                text eol=lf
Dockerfile          text eol=lf
*.yaml              text eol=lf
*.yml               text eol=lf
.env.example        text eol=lf

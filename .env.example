# Copier vers .env puis remplacer chaque valeur "change-me".
# Ne jamais versionner .env.

# --- PostgreSQL ---
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me

# --- Mosquitto : un compte par client (cf. infra/mosquitto/acl) ---
MQTT_BACKEND_PASSWORD=change-me
# Compte du boîtier physique : nom d'utilisateur = identifiant du boîtier
MQTT_DEVICE_ID=esp-01
MQTT_DEVICE_PASSWORD=change-me
# Compte du simulateur (profil compose "sim")
MQTT_SIM_PASSWORD=change-me

# --- API ---
# Clé envoyée par le service IA dans l'en-tête X-API-Key de POST /api/v1/alerts
ALERTS_API_KEY=change-me
# Compte superviseur du dashboard
DASHBOARD_USER=superviseur
DASHBOARD_PASSWORD=change-me
# Clé de signature des sessions (ex. : openssl rand -hex 32)
SESSION_SECRET=change-me
# Délais (secondes)
COMMAND_TIMEOUT_SECONDS=10
STALE_AFTER_SECONDS=15
# Flux MJPEG fourni par le service IA sur le PC serveur (relayé par l'API)
VIDEO_STREAM_URL=http://host.docker.internal:8081/stream

# --- Mode compatibilité TEMPORAIRE avec l'ancien firmware / ancien script de vision ---
# true = MQTT en clair et anonyme sur MQTT_LEGACY_PORT (topics sentinel/telemetry,
# sentinel/commands, sentinel/alerts/vision). À remettre à false avant la démo.
LEGACY_MQTT_ENABLED=false
MQTT_LEGACY_PORT=1883

# --- Ports exposés sur le PC serveur ---
HTTPS_PORT=443
HTTP_PORT=80
MQTTS_PORT=8883
